# --- App ---
APP_BASE_URL=http://localhost:3020
APP_BIND_HOST=127.0.0.1
APP_PORT=3020
APP_DATA_DIR=/app/data
LOG_LEVEL=info

# Set both to enable the built-in HTTP Basic Auth (recommended if the UI is
# reachable beyond localhost). /health stays open for container health checks.
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=
APP_BASIC_AUTH_PASSWORD_FILE=

# Force demo (1) or live (0) backends. Leave unset to auto-detect from creds.
DEMO_MODE=

# --- Encryption (required before persisting tokens) ---
# AES-256-GCM key. Provide either base64-encoded 32 bytes (recommended, e.g.
# `openssl rand -base64 32`) or a raw string of at least 32 characters.
# Provide either the value or the *_FILE path, never both.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_FILE=

# --- Actual Budget ---
ACTUAL_SERVER_URL=
ACTUAL_PASSWORD=
ACTUAL_PASSWORD_FILE=
ACTUAL_ENCRYPTION_PASSWORD=
ACTUAL_ENCRYPTION_PASSWORD_FILE=
ACTUAL_SYNC_ID=

# --- TrueLayer ---
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_CLIENT_SECRET_FILE=
TRUELAYER_REDIRECT_MODE=manual
TRUELAYER_CALLBACK_URL=
# Use TrueLayer's sandbox environment (auth/api .truelayer-sandbox.com) for the
# first live test. Optionally override the base URLs directly.
TRUELAYER_USE_SANDBOX=false
TRUELAYER_AUTH_BASE_URL=
TRUELAYER_API_BASE_URL=

# --- Sync ---
SYNC_INTERVAL_HOURS=0
SYNC_OVERLAP_DAYS=3
SYNC_DAYS_LOOKBACK=7
BALANCE_DRIFT_WARNING_MINOR=100
CONSENT_EXPIRY_WARNING_DAYS=14
